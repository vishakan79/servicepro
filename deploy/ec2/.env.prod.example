# Copy to .env on the EC2 instance (chmod 600). Never commit it.
API_DOMAIN=api.example.com
# ECR image pushed by CI, e.g. 123456789012.dkr.ecr.ap-south-1.amazonaws.com/fieldservicely-api:latest
API_IMAGE=
AWS_REGION=ap-south-1

# PostgreSQL 14+ (RDS or Neon). RDS: private subnet; security group allows 5432 only from this instance's security group
DB_HOST=fieldservicely.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_NAME=fieldservicely
DB_USER=fieldservicely
DB_PASSWORD=
DB_PORT=5432
DB_SSLMODE=require

# openssl rand -base64 48
JWT_SECRET=

# Frontend origins allowed for CORS and the WebSocket handshake (no trailing slash)
CORS_ORIGINS=https://your-app.vercel.app

# Mobile (SMS) and email-link verification are done by Firebase; the server only verifies the ID tokens of this project.
FIREBASE_PROJECT_ID=servicepro-a8d32

# The first admin (created once at startup). Mobile in international format; password 8-72 characters.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
